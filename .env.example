# Copy to .env (never commit .env). Every value is optional.

# replay = recorded responses from agent/recordings/ (default, no network, no key)
# live   = OpenAI-compatible endpoint below (Groq, Google AI Studio, local Ollama, ...)
LLM_MODE=replay
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# RECORD=1 (exactly "1") merges every successful live response into
# agent/recordings/<incident_id>.json so replay reproduces the live run. Off by default.
RECORD=

# LLM_HYPOTHESES=1 (exactly "1") asks the LLM for up to 2 extra hypotheses after the seeds. The
# evidence engine tests them like any other. Off by default; replay adds them only if recorded.
LLM_HYPOTHESES=

# Delay between agent steps so the UI can show progress (tests use 0)
STEP_DELAY_MS=600
