# Copy to .env (never commit .env). Every value is optional.

# replay = recorded responses from agent/recordings/ (default, no network, no key)
# live   = OpenAI-compatible endpoint below (Groq, Google AI Studio, local Ollama, ...)
LLM_MODE=replay
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Delay between agent steps so the UI can show progress (tests use 0)
STEP_DELAY_MS=600
